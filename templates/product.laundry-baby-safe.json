    "faq_section_efbUKn": {
      "type": "faq-section",
      "blocks": {
        "section_Wn3Lay": {
          "type": "section",
          "settings": {
            "question": "How does it work?",
            "answer": "Upon contact with water our sheets will instantly begin to return to their liquid state and mix with the water flow in your machine to give your clothes a proper clean! They work in all washes, even cold and quick."
          }
        },
        "section_9NNBHe": {
          "type": "section",
          "settings": {
            "question": "How many sheets do I need per wash?",
            "answer": "The number of sheets you'll need to use can depend on a few factors, including the size of your laundry load, how dirty your clothes are and how soft/hard your water is. For a standard washing machine with a regular to large load, just half a sheet should do the trick.If  you're tackling a much larger load you might want to use a whole sheet or two. This ensures that the larger volume of water and clothing gets evenly cleaned."
          }
        },
        "section_YUTVE8": {
          "type": "section",
          "settings": {
            "question": "Are they vegan and cruelty free?",
            "answer": "Yes! Our products are never tested on animals and our Laundry Detergent Sheets are also vegan!"
          }
        },
        "section_x8n6jm": {
          "type": "section",
          "settings": {
            "question": "What are the ingredients?",
            "answer": " ≥30% anionic surfactants are plant-based cleaners that lift away dirt and stains.<5% amphoteric surfactants non-ionic surfactants boost cleaning power while being gentle on skin. Perfume adds our signature floral, summer-inspired fragrance. Benzyl alcohol and benzoic acid keep the formula fresh and effective. Contains: Sodium dodecyl sulfate; Inner salt of N-cocoacyl derivatives of (3-aminopropan-1-yl)(carboxymethyl)dimethylammonium and Ylang-Ylang oil. No Harsh Chemicals:  Our detergent is free of unnecessary dyes, parabens, and plastics."
          }
        },
        "section_VBp9Nc": {
          "type": "section",
          "settings": {
            "question": "Can I use the laundry detergent sheets for hand wash?",
            "answer": "Yes! Our sheets instantly begin to return to their liquid state when in contact with water and are very easy to use for hand wash or travel."
          }
        },
        "section_LLpxUC": {
          "type": "section",
          "settings": {
            "question": "How strong is the scent after washing?",
            "answer": "Keep in mind there are far less chemicals in our laundry detergent meaning the scent does not linger as long as regular laundry detergent and becomes more fragrant when fabric dries after washing."
          }
        }
      },
