<style>
  .carPage .product-item {
    height: 300px;
    width: 100%;
  }
  .carPage .cart-btn span {
    font-size: 14px !important;
    padding: 5px 15px !important;
  }
  .carPage .product-top {
    align-items: start !important;
    flex-direction: column !important;
  }
  .carPage .product-item .product-content h3 {
    height: 20px !important;
  }
  .carPage .product-item .product-img img {
    height: 180px;
  }
  .carPage .product-item .product-img .offer-thumb span {
    padding: 3px 10px;
    line-height: 15px;
    font-size: 11px;
  }
</style>
<section class="product-area productGridSection carPage">
  <div class="">
    {% if section_title != blank %}
      <div class="section-title slider-section-title">
        <h2>{{ section_title }}</h2>
      </div>
    {% endif %}
    {% if tab_title != blank %}
      <div class="product-tab tabs">
        <button class="tab-link active allow">{{ tab_title }}</button>
      </div>
    {% endif %}
    <div class="tab-content active">
      <div class="product-wrap">
        <div class="row-grids cartPrdItems">
          {% for product in collections[tab_collection].products %}
            {% if product.tags contains 'Active' %}
              <div class="grid">
                <div class="product-item">
                  <div class="product-img">
                    <img
                      src="{{ product.featured_image |  image_url: width: 900  }}"
                      alt=""
                      width=""
                      height="">
                    <div class="offer-thumb">
                      {% if product.tags != blank %}
                        {% for tag in product.tags %}
                          {% if tag != "Active" %}
                            <span>
                              {{ tag }}
                            </span>
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>

                  </div>
                  <div class="product-content">
                    <div class="product-top">
                      <h3>
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>
                    {% comment %} <div class="product-btm">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <span>{{ product.metafields.custom.review }} Reviews</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div class="product-ratting">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <ul>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <li>&#9733;</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <li>&#9733;</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <li>&#9733;</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <li>&#9733;</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <li>&#9733;</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </ul>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div> {% endcomment %}
                    </div>
                    <div class="cart-btn addToCart" onclick="addToCart({{product.variants.first.id}})">
                      <input
                        type="hidden"
                        name="id"
                        id="variantId"
                        value="{{ product.variants.first.id }}">
                      <input
                        type="hidden"
                        name="quantity"
                        id="quantity"
                        value="1"
                        min="1">
                      <span>
                        Add to Bag
                        {{ product.price | money }}</span>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>