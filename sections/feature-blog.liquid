<style>

  /* Containercs */
  .containercs {
    display: grid;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 32px 70px;
  }

  /* Main Card */
  .main-card {
    display: flex;
    align-items: center;
    background: #f5f5f5;
    border-radius: 10px;
    overflow: hidden;
  }

  .main-card img {
    width: 100%;
    height: 500px;
    object-fit: cover;
  }

  .main-card .content {
    padding: 24px;
    width: 50%;
  }

  .main-card h2 {
    font-size: 20px;
    font-weight: bold;
    font-style: italic;
  }

  .main-card p {
    margin-top: 8px;
    color: #555;
    line-height: 1.5;
  }
  .main-card .cardImage {
    width: 100%;
  }

  .main-card a {
    display: inline-block;
    margin-top: 12px;
    font-weight: bold;
    text-decoration: none;
    color: black;
    border-bottom: 2px solid black;
  }

  /* Grid Layout for Smaller Cards */
  .grid-containercs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Smaller Cards */
  .card {
    display: flex;
    flex-direction: column;
    justify-content: start;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .card img {
    width: 100%;
    height: 300px;
    object-fit: cover;
  }

  .card .content {
    padding: 16px;
  }
  .content span {
    font-weight: 400;
    color: #6e6c6c;
    font-size: 14px;
  }

  .card h3 {
    font-size: 18px;
    font-weight: bold;
  }

  .card p {
    margin-top: 8px;
    color: #666;
    line-height: 1.5;
  }


  .card a {
    display: inline-block;
    margin-top: 12px;
    font-weight: bold;
    text-decoration: none;
    color: black;
    border-bottom: 2px solid black;
  }
  a.linkStyle {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    text-decoration: none !important;
    border-bottom: 0 !important;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .main-card {
      flex-direction: column;
    }

    .main-card img,
    .main-card .content {
      width: 100%;
    }

    .grid-containercs {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="feature-blog">


  <div class="containercs">
    <!-- Main Card -->
    {%- assign featured_article = section.settings.article -%}
    {%- assign featured_articl_2 = section.settings.article_2 -%}
    {%- assign featured_articl_3 = section.settings.article_3 -%}

    <div class="main-card">
      <a href="{{ featured_article.url }}" class="linkStyle">
        <div class="cardImage">
          <img
            src="{{ featured_article.image | image_url: width: 800  }}"
            width=""
            height=""
            alt="{{ featured_article.title }}">
        </div>
      </a>

      <div class="content">
        <a href="{{ featured_article.url }}" class="linkStyle">
          <h2>{{ featured_article.title }}</h2>
        </a>
        <p>{{ featured_article.excerpt }}</p>
        <a href="{{ featured_article.url }}">Read more</a>
      </div>
    </div>


    <!-- Grid Section -->

    <div class="grid-containercs">
      <!-- Card 1 -->
      <div class="card">
        <a href="{{ featured_articl_2.url }}" class="linkStyle">
          <img
            src="{{ featured_articl_2.image | image_url: width: 800  }}"
            width=""
            height=""
            alt="{{ featured_articl_2.title }}">
        </a>
        <div class="content">
          <a href="{{ featured_articl_2.url }}" class="linkStyle">
            <h3>{{ featured_articl_2.title }}</h3>
          </a>
          <p>{{ featured_articl_2.excerpt }}</p>
          <a href="{{ featured_articl_2.url }}">Read more</a>
        </div>
      </div>


      <!-- Card 2 -->
      <div class="card">
        <a href="{{ featured_articl_3.url }}" class="linkStyle">
          <img
            src="{{ featured_articl_3.image | image_url: width: 800  }}"
            width=""
            height=""
            alt="{{ featured_articl_3.title }}">
        </a>
        <div class="content">
          <a href="{{ featured_articl_3.url }}" class="linkStyle">
            <h3>{{ featured_articl_3.title }}</h3>
          </a>
          <p>{{ featured_articl_3.excerpt }}</p>
          <a href="{{ featured_articl_3.url }}">Read more</a>
        </div>
      </div>

    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Feature Blog",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fafafa"
      }, {
        "type": "article",
        "id": "article",
        "label": "Article",
        "info": "Feature a blog post"
      }, {
        "type": "article",
        "id": "article_2",
        "label": "Article 2",
        "info": "Feature a blog post"
      }, {
        "type": "article",
        "id": "article_3",
        "label": "Article 3",
        "info": "Feature a blog post"
      }
    ],

    "presets": [
      {
        "name": "Feature Blog"
      }
    ]
  }
{% endschema %}