<style>
  .testimonial-section {
    margin: 0 auto;
    padding-bottom: 40px;
    width: 50%;
    text-align: center;
  }
  .testiRating {
    margin: 0;
    padding: 0;
  }
  .testiRating li {
    display: inline-block;
    list-style: none;
  }
  .testiText {
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 20px;
  }
  .testimonial-section .owl-nav {
    display: none;
  }
  @media screen and (max-width: 768px) {
    .testimonial-section {
      width: 100%;
      padding: 10px 20px;
    }
  }
</style>

<section class="testimonial-section">
  {% if section.settings.title != blank %}
    <h1>{{ section.settings.title }}</h1>
  {% endif %}


  <div class="testimonial-active owl-carousel">
    {% for block in section.blocks %}
      <div class="testiBox">
        <p class="testiText">"{{ block.settings.testimonial }}"</p>
        <ul class="testiRating">
          {% for i in (1..block.settings.taring) %}
            <li>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="25"
                height="25"
                color="#ffe604"
                fill="#ffe604">
                <path
                  d="M13.7276 3.44418L15.4874 6.99288C15.7274 7.48687 16.3673 7.9607 16.9073 8.05143L20.0969 8.58575C22.1367 8.92853 22.6167 10.4206 21.1468 11.8925L18.6671 14.3927C18.2471 14.8161 18.0172 15.6327 18.1471 16.2175L18.8571 19.3125C19.417 21.7623 18.1271 22.71 15.9774 21.4296L12.9877 19.6452C12.4478 19.3226 11.5579 19.3226 11.0079 19.6452L8.01827 21.4296C5.8785 22.71 4.57865 21.7522 5.13859 19.3125L5.84851 16.2175C5.97849 15.6327 5.74852 14.8161 5.32856 14.3927L2.84884 11.8925C1.389 10.4206 1.85895 8.92853 3.89872 8.58575L7.08837 8.05143C7.61831 7.9607 8.25824 7.48687 8.49821 6.99288L10.258 3.44418C11.2179 1.51861 12.7777 1.51861 13.7276 3.44418Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
</section>


{% schema %}
  {
    "name": "Testimonial Section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Section Title",
        "default": "INTRODUCING THE LINEUP"
      }
    ],
    "blocks": [
      {
        "name": "Testimonial Item",
        "type": "slider",
        "settings": [
          {
            "type": "text",
            "id": "testimonial",
            "label": "Testimonial",
            "default": "Mabango not only looks beautiful, but smells beatuful too. enriched with Ylang Ylang it gives my laundry a subtle fragrance which I love."
          }, {
            "type": "range",
            "id": "taring",
            "label": "Rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "default": 5
          }
        ]
      }
    ],

    "presets": [
      {
        "name": "Testimonial Section",
        "blocks": [
          {
            "type": "slider"
          }
        ]
      }
    ]
  }
{% endschema %}