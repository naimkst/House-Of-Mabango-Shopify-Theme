<style>
  .imageSection {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 0;
  }

  .imageBox {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .imgDesktop {
    display: block;
  }

  .imgMobile {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .imgDesktop {
      display: none;
    }

    .imgMobile {
      display: block;
    }
  }
</style>


<div class="imageSection">
  <div class="imageBox">
    <div class="imgDesktop">
      <img
        src="{{ section.settings.desktop_image |  image_url: width: 1920
          }}"
        alt=""
        width=""
        height=""
        alt="">
    </div>
    <div class="imgMobile">
      <img
        src="{{ section.settings.mobile_image  |  image_url: width: 1000  }}"
        alt=""
        width=""
        height=""
        alt="">
    </div>


  </div>

</div>


{% schema %}
  {
    "name": "Image Section",
    "settings": [
      {
        "type": "image_picker",
        "id": "desktop_image",
        "label": "Desktop Image"
      }, {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Image"
      }

    ],

    "presets": [
      {
        "name": "Image Section"
      }
    ]
  }
{% endschema %}