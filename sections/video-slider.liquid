<style>
  .video-slider-container {
    padding: 80px 10px;
    background: {{ section.settings.video_section_bg_color }};
  }

  .swiperSection {
    width: 100%;
    overflow: hidden;
    margin-top: 50px;
  }

  .swiper-slide {
    width: 250px;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    font-family: sans-serif;
    border: 2px solid #fcea9f;
  }

  .swiper-slide video,
  .swiper-slide img {
    width: 100%;
    display: block;
    object-fit: cover;
    height: 100%;
  }

  .video-caption {
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }

  .video-caption span {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    color: #ff5722;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide-video {
    width: 100%;
    height: auto;
    display: block;
  }

  .play-pause-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: transparent;
      color: #fff;
      border: none;
      cursor: pointer;
      z-index: 5;
      font-size: 30px;
  }
  img.play-pause-btn {
    width: 30px;
    height: 30px;
}
img.play-pause-btn.active {
    display: none;
}
</style>

<section class="video-slider-container">

  <div class="section-title slider-section-title">
    <h2>{{ section.settings.video_sectuib_title }}</h2>
  </div>


  <div class="swiperSection mySwiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="video-wrapper">
            <video
              loop
              poster="{{ block.settings.video_url.preview_image | image_url }}"
              playsinline
              muted
              class="slide-video playOrPause"
              src="{{ block.settings.video_url.sources[1].url }}" type="video/mp4"></video>
            <img class="play-pause-btn playOrPause" src="{{ "play.svg" | asset_url }}" width="40" height="40"/>
          </div>
          <div class="video-caption">
            “{{ block.settings.video_title }}”
            <span>{{ block.settings.video_name }} - {{ block.settings.use_name }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
  {
    "name": "Video Slider",
    "settings": [
      {
        "type": "text",
        "id": "video_sectuib_title",
        "label": "Video Section Title",
        "default": "Words of affirmation from our favorite humans"
      },{
        "type": "color",
        "id": "video_section_bg_color",
        "label": "Video Section Background Color",
        "default": "#ffffff",
      }
    ],
    "blocks": [
      {
        "type": "video",
        "name": "Video",
        "settings": [
          {
            "type": "text",
            "id": "video_title",
            "label": "Video Title",
            "default": "This scent makes me feel so much more confident"
          }, {
            "type": "text",
            "id": "video_name",
            "label": "Video Name",
            "default": "Emily R."
          }, {
            "type": "text",
            "id": "use_name",
            "label": "Use Name",
            "default": "Mini Hand + Body Wash Milk"
          }, {
            "type": "video",
            "id": "video_url",
            "label": "Video URL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Video Slider",
        "blocks": [
          {
            "type": "video"
          }
        ]
      }
    ]
  }
{% endschema %}